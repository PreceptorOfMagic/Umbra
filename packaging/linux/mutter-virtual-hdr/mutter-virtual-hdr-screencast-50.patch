+static void
+clear_format (MetaScreenCastFormat *format)
+{
+  g_clear_object (&format->color_state);
+}
+
+/* Ported from the monitor source's update_formats(): the default 8-bit formats, plus
+ * 10-bit and half-float formats carrying the monitor's colour state when it is BT.2100. */
+static void
+update_formats (MetaScreenCastVirtualStreamSrc *virtual_src)
+{
+  MetaBackend *backend = backend_from_src (META_SCREEN_CAST_STREAM_SRC (virtual_src));
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+  MetaMonitor *monitor = monitor_from_src (virtual_src);
+  MetaColorDevice *color_device = NULL;
+  ClutterColorState *color_state = NULL;
+  int i;
+  const CoglPixelFormat basic_formats[] = {
+    COGL_PIXEL_FORMAT_BGRX_8888,
+    COGL_PIXEL_FORMAT_BGRA_8888_PRE,
+  };
+
+  if (monitor)
+    color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  if (color_device)
+    color_state = meta_color_device_get_color_state (color_device);
+
+  g_clear_pointer (&virtual_src->formats, g_array_unref);
+  virtual_src->formats = g_array_new (TRUE, TRUE, sizeof (MetaScreenCastFormat));
+  g_array_set_clear_func (virtual_src->formats, (GDestroyNotify) clear_format);
+
+  for (i = 0; i < G_N_ELEMENTS (basic_formats); i++)
+    {
+      MetaScreenCastFormat format = {
+        .format = basic_formats[i],
+      };
+
+      g_array_append_val (virtual_src->formats, format);
+    }
+
+  if (CLUTTER_IS_COLOR_STATE_PARAMS (color_state))
+    {
+      ClutterColorStateParams *color_state_params =
+        CLUTTER_COLOR_STATE_PARAMS (color_state);
+      const ClutterColorimetry *colorimetry;
+
+      colorimetry =
+        clutter_color_state_params_get_colorimetry (color_state_params);
+
+      if (colorimetry->type == CLUTTER_COLORIMETRY_TYPE_COLORSPACE &&
+          colorimetry->colorspace == CLUTTER_COLORSPACE_BT2020 &&
+          is_pq_color_state (color_state))
+        {
+          const CoglPixelFormat hdr_formats[] = {
+              COGL_PIXEL_FORMAT_XRGB_2101010,
+              COGL_PIXEL_FORMAT_XBGR_2101010,
+              COGL_PIXEL_FORMAT_RGBA_FP_16161616_PRE,
+          };
+
+          for (i = 0; i < G_N_ELEMENTS (hdr_formats); i++)
+            {
+              MetaScreenCastFormat format = {
+                .format = hdr_formats[i],
+                .color_state = g_object_ref (color_state),
+              };
+
+              g_array_append_val (virtual_src->formats, format);
+            }
+        }
+    }
+}
+
+static const MetaScreenCastFormat *
+meta_screen_cast_virtual_stream_src_get_formats (MetaScreenCastStreamSrc *src)
+{
+  MetaScreenCastVirtualStreamSrc *virtual_src =
+    META_SCREEN_CAST_VIRTUAL_STREAM_SRC (src);
+
+  update_formats (virtual_src);
+
+  return (const MetaScreenCastFormat *) virtual_src->formats->data;
+}
+
+/* Switching the virtual monitor's colour mode (DisplayConfig "color-mode") changes its
+ * colour state after the stream was negotiated; offer the new formats then. */
+static void
+on_device_color_state_changed (MetaColorManager               *color_manager,
+                               MetaColorDevice                *color_device,
+                               MetaScreenCastVirtualStreamSrc *virtual_src)
+{
+  MetaMonitor *monitor = monitor_from_src (virtual_src);
+
+  if (!monitor || meta_color_device_get_monitor (color_device) != monitor)
+    return;
+
+  g_clear_object (&virtual_src->blending_pipeline);
+  g_clear_object (&virtual_src->blending_framebuffer);
+  meta_screen_cast_stream_src_renegotiate (META_SCREEN_CAST_STREAM_SRC (virtual_src));
+}
