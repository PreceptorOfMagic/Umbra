+/* Ported from the monitor source (ensure_blending_pipeline), but rebuilt when the
+ * stream size changes: a virtual monitor can be resized while streaming. */
+static gboolean
+ensure_blending_pipeline (MetaStreamSourceVirtual  *source_virtual,
+                          CoglFramebuffer          *target_framebuffer,
+                          ClutterColorState        *blending_color_state,
+                          ClutterColorState        *target_color_state,
+                          CoglPipeline            **blending_pipeline,
+                          CoglFramebuffer         **blending_framebuffer,
+                          GError                  **error)
+{
+  MetaBackend *backend = backend_from_source (META_STREAM_SOURCE (source_virtual));
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context = clutter_backend_get_cogl_context (clutter_backend);
+  int width = cogl_framebuffer_get_width (target_framebuffer);
+  int height = cogl_framebuffer_get_height (target_framebuffer);
+  ClutterEncodingRequiredFormat required_format;
+  CoglPixelFormat formats[10];
+  size_t n_formats = 0;
+  g_autoptr (CoglOffscreen) offscreen = NULL;
+  g_autoptr (CoglPipeline) pipeline = NULL;
+
+  if (source_virtual->blending_pipeline && source_virtual->blending_framebuffer &&
+      cogl_framebuffer_get_width (source_virtual->blending_framebuffer) == width &&
+      cogl_framebuffer_get_height (source_virtual->blending_framebuffer) == height)
+    {
+      *blending_pipeline = source_virtual->blending_pipeline;
+      *blending_framebuffer = source_virtual->blending_framebuffer;
+      return TRUE;
+    }
+
+  required_format = clutter_color_state_required_format (blending_color_state);
+  if (required_format <= CLUTTER_ENCODING_REQUIRED_FORMAT_UINT8)
+    {
+      formats[n_formats++] =
+        cogl_framebuffer_get_internal_format (target_framebuffer);
+    }
+  else
+    {
+      formats[n_formats++] = COGL_PIXEL_FORMAT_RGBX_FP_16161616;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_BGRX_FP_16161616;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_XRGB_FP_16161616;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_XBGR_FP_16161616;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_RGBA_FP_16161616_PRE;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_BGRA_FP_16161616_PRE;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_ARGB_FP_16161616_PRE;
+      formats[n_formats++] = COGL_PIXEL_FORMAT_ABGR_FP_16161616_PRE;
+    }
+
+  offscreen = cogl_offscreen_new_from_formats (cogl_context,
+                                               formats, n_formats,
+                                               width, height,
+                                               error);
+  if (!offscreen)
+    return FALSE;
+
+  pipeline = cogl_pipeline_new (cogl_context);
+  cogl_pipeline_set_layer_texture (pipeline, 0,
+                                   cogl_offscreen_get_texture (offscreen));
+
+  clutter_color_pipeline_shader_set_color_state (pipeline,
+                                                 blending_color_state,
+                                                 target_color_state,
+                                                 CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+
+  g_set_object (&source_virtual->blending_pipeline, pipeline);
+  g_set_object (&source_virtual->blending_framebuffer,
+                COGL_FRAMEBUFFER (offscreen));
+  *blending_pipeline = source_virtual->blending_pipeline;
+  *blending_framebuffer = source_virtual->blending_framebuffer;
+  return TRUE;
+}
+
+/* HDR stream: paint the stage for this virtual monitor straight into the stream's
+ * (10-bit or half-float) buffer in the negotiated BT.2100 colour state, exactly as
+ * the monitor source's stage-paint path does. The view's own buffer is not used. */
+static gboolean
+record_hdr_to_framebuffer (MetaStreamSourceVirtual  *source_virtual,
+                           ClutterStageView         *view,
+                           CoglFramebuffer          *framebuffer,
+                           ClutterColorState        *target_color_state,
+                           MtkRegion                *damage,
+                           GError                  **error)
+{
+  MetaStreamSource *source = META_STREAM_SOURCE (source_virtual);
+  MetaStream *stream = meta_stream_source_get_stream (source);
+  MetaBackend *backend = backend_from_source (source);
+  MetaContext *context = meta_backend_get_context (backend);
+  MetaDebugControl *debug_control = meta_context_get_debug_control (context);
+  ClutterPaintFlag paint_flags = CLUTTER_PAINT_FLAG_NONE;
+  g_autoptr (ClutterColorState) blending_color_state = NULL;
+  MtkRectangle view_rect;
+  float scale;
+  gboolean force_linear;
+
+  clutter_stage_view_get_layout (view, &view_rect);
+  scale = clutter_stage_view_get_scale (view);
+
+  switch (meta_stream_get_cursor_mode (stream))
+    {
+    case META_STREAM_CURSOR_MODE_METADATA:
+    case META_STREAM_CURSOR_MODE_HIDDEN:
+      paint_flags |= CLUTTER_PAINT_FLAG_NO_CURSORS;
+      break;
+    case META_STREAM_CURSOR_MODE_EMBEDDED:
+      paint_flags |= CLUTTER_PAINT_FLAG_FORCE_CURSORS;
+      break;
+    }
+
+  force_linear = meta_debug_control_is_linear_blending_forced (debug_control);
+  blending_color_state = clutter_color_state_get_blending (target_color_state,
+                                                           force_linear);
+
+  if (!clutter_color_state_equals (target_color_state, blending_color_state))
+    {
+      CoglPipeline *blending_pipeline;
+      CoglFramebuffer *blending_framebuffer;
+
+      if (!ensure_blending_pipeline (source_virtual,
+                                     framebuffer,
+                                     blending_color_state,
+                                     target_color_state,
+                                     &blending_pipeline,
+                                     &blending_framebuffer,
+                                     error))
+        return FALSE;
+
+      meta_stream_source_paint_to_framebuffer_clipped (source,
+                                                       blending_framebuffer,
+                                                       &view_rect,
+                                                       scale,
+                                                       blending_color_state,
+                                                       damage,
+                                                       paint_flags);
+      cogl_framebuffer_draw_textured_rectangle (framebuffer,
+                                                blending_pipeline,
+                                                -1, 1, 1, -1,
+                                                0, 0, 1, 1);
+    }
+  else
+    {
+      meta_stream_source_paint_to_framebuffer_clipped (source,
+                                                       framebuffer,
+                                                       &view_rect,
+                                                       scale,
+                                                       target_color_state,
+                                                       damage,
+                                                       paint_flags);
+    }
+
+  cogl_framebuffer_flush (framebuffer);
+  return TRUE;
+}
