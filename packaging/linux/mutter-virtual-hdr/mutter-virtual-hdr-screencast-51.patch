+/* The stream's colour state comes from the negotiated format; only a BT.2100 (PQ)
+ * format takes the colour-managed path below, so SDR streams are recorded as before. */
+static gboolean
+is_pq_color_state (ClutterColorState *color_state)
+{
+  const ClutterEOTF *eotf;
+
+  if (!CLUTTER_IS_COLOR_STATE_PARAMS (color_state))
+    return FALSE;
+
+  eotf = clutter_color_state_params_get_eotf (CLUTTER_COLOR_STATE_PARAMS (color_state));
+  return eotf->type == CLUTTER_EOTF_TYPE_NAMED &&
+         eotf->tf_name == CLUTTER_TRANSFER_FUNCTION_PQ;
+}
