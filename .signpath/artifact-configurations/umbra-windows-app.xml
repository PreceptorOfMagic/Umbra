<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "umbra-windows-app" (a copy of what is configured in SignPath).
     Input: the GitHub Actions artifact uploaded by release-windows-signed.yml (GitHub always zips
     artifacts), laid out as in the installed package. Only binaries built from this repository and
     the GPU HEVC co-op encoder built from the Eclipse repository are signed; the SudoVDA driver,
     nefconc.exe, the ViGEmBus installer and zlib1.dll are third-party and are never sent. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="sunshine.exe"><authenticode-sign/></pe-file>
    <pe-file path="aurora-link.exe"><authenticode-sign/></pe-file>
    <pe-file path="tools/audio-info.exe"><authenticode-sign/></pe-file>
    <pe-file path="tools/dxgi-info.exe"><authenticode-sign/></pe-file>
    <pe-file path="tools/sunshinesvc.exe"><authenticode-sign/></pe-file>
    <pe-file path="gpu-hevc/aurora_gpu_hevc8.dll"><authenticode-sign/></pe-file>
    <pe-file path="gpu-hevc/aurora_gpu_hevc10.dll"><authenticode-sign/></pe-file>
  </zip-file>
</artifact-configuration>
