{
  "env": {},
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png",
      "allow-client-commands": false
    },
    {
      "name": "Steam Big Picture",
      "prep-cmd": [
        {
          "do": "",
          "undo": "steam://close/bigpicture",
          "elevated": false
        }
      ],
      "detached": [
        "steam://open/bigpicture"
      ],
      "image-path": "steam.png"
    },
    {
      "name": "Co-op Pane",
      "virtual-display": true,
      "auto-detach": true,
      "terminate-on-pause": true,
      "wait-all": false,
      "exit-timeout": 5
    }
  ]
}
