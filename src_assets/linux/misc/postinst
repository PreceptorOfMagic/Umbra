#!/bin/sh
set -eu

# Immutable rpm-ostree deployments apply the packaged capabilities at deployment.
if command -v rpm-ostree >/dev/null 2>&1; then
  echo "rpm-ostree environment detected; restart to apply the packaged changes."
  exit 0
fi

# Use the exact package path, never whichever sunshine happens to precede it in PATH.
path_to_sunshine=$(readlink -f '@CMAKE_INSTALL_FULL_BINDIR@/sunshine')
[ -x "$path_to_sunshine" ] || { echo "Installed host executable is missing." >&2; exit 1; }
path_to_setcap=$(command -v setcap) || { echo "Required setcap tool is missing." >&2; exit 1; }
"$path_to_setcap" cap_sys_admin+p "$path_to_sunshine"
echo "CAP_SYS_ADMIN capability set on the installed host executable."

path_to_udevadm=$(command -v udevadm) || { echo "Required udevadm tool is missing." >&2; exit 1; }
if [ -S /run/udev/control ]; then
  "$path_to_udevadm" control --reload-rules
  "$path_to_udevadm" trigger --property-match=DEVNAME=/dev/uinput
  "$path_to_udevadm" trigger --property-match=DEVNAME=/dev/uhid
  echo "Udev rules reloaded."
else
  echo "Udev is not running; installed rules take effect at the next boot."
fi
